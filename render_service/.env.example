# development | test | production (docs and OpenAPI are disabled in production)
ENVIRONMENT=development

# Supabase project URL, used to fetch the JWKS for token verification.
SUPABASE_URL=https://your-project-ref.supabase.co

# Skips token verification. Only accepted when ENVIRONMENT=development.
AUTH_DISABLED=false

# Comma-separated list of browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:3000
